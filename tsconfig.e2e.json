  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./apps/web/node_modules/@types"]
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts", "scripts/e2e/*.mjs"]
}
