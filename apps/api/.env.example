NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

# Local Postgres (docker-compose.yml at repo root)
DB_HOST=localhost
DB_PORT=5432
DB_USER=move
DB_PASSWORD=move
DB_NAME=move
DB_SSL=false

# Public URL of this API (OAuth and Mercado Pago callbacks)
API_PUBLIC_URL=http://localhost:3001

# Better Auth (dev-only secret; use a random 32+ char value outside development)
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
COOKIE_DOMAIN=

# Google OAuth (optional: set both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Calendar sync for Rehab (optional; also needs GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET). 32 random bytes in
# base64 (`openssl rand -base64 32`): encrypts the calendar refresh token. Redirect URI to register in Google:
# ${API_PUBLIC_URL}/api/calendar/oauth/callback
CALENDAR_TOKEN_KEY=

# Mercado Pago (empty = development payment simulator; required in production)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Brevo (empty = dry-run, emails are logged instead of sent; required in production)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MOVE

# Scheduler (set to false on every instance but one)
SCHEDULER_ENABLED=true

# Proxies in front of the API whose X-Forwarded-For entry is trusted to get the client IP (0-5, 0 = ignore the
# header). 2 behind the Elastic Beanstalk ALB + Nginx. Never `true`.
TRUST_PROXY_HOPS=0
